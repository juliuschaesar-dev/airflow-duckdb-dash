# Copy this file to `.env` and adjust values as needed.
# `.env` is gitignored — real/local credentials never get committed.

POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin

AIRFLOW_JWT_SECRET=airflow_jwt_secret
AIRFLOW_JWT_ISSUER=airflow

# CoinGecko /coins/markets endpoint the extract task calls
CRYPTO_API_BASE_URL=https://api.coingecko.com/api/v3/coins/markets
CRYPTO_TOP_N=250

# Dashboard auto-refresh interval, in milliseconds (10 min)
CRYPTO_REFRESH_MS=600000
